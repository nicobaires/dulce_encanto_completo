---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.svelte';
import Hero from '../components/Hero.astro';
import Productos from '../components/Productos.astro';
import Destacados from '../components/Destacados.astro';
import SobreMi from '../components/SobreMi.astro';
import Pedidos from '../components/Pedidos.astro';
import Beneficios from '../components/Beneficios.astro';
import Testimonios from '../components/Testimonios.svelte';
import Contacto from '../components/Contacto.svelte';
import Footer from '../components/Footer.astro';
---

<Layout title="Dulce Encanto - Pastelería Artesanal" description="Pastelería artesanal en Buenos Aires. Tortas, budines, alfajores y postres caseros hechos con amor. Pedí por WhatsApp." businessSchema={true}>
  <Nav client:load />
  <Hero />
  <Productos />
  <Destacados />
  <SobreMi />
  <Pedidos />
  <Beneficios />
  <Testimonios client:load />
  <Contacto client:load />
  <Footer />
</Layout>
