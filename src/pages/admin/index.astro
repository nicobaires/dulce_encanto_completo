<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dulce Encanto - Admin</title>
  <script is:inline>
    window.CMS_MANUAL_INIT = true;
  </script>
  <script is:inline src="https://unpkg.com/decap-cms@^3/dist/decap-cms.js"></script>
  <script is:inline>
    CMS.init({
      config: {
        backend: {
          name: 'git-gateway',
          branch: 'main',
        },
        local_backend: true,
        media_folder: 'src/assets/images',
        public_folder: '/img',
        collections: [
          {
            name: 'category',
            label: 'Categorías',
            label_singular: 'Categoría',
            folder: 'src/content/category',
            create: true,
            format: 'yaml',
            identifier_field: 'name',
            summary: '{{name}}',
            fields: [
              { label: 'Nombre', name: 'name', widget: 'string' },
              { label: 'Icono (FontAwesome)', name: 'icon', widget: 'string', default: 'fa-birthday-cake' },
              { label: 'Descripción', name: 'description', widget: 'text' },
              { label: 'Imagen', name: 'image', widget: 'image', choose_url: false },
            ],
          },
          {
            name: 'product',
            label: 'Productos',
            label_singular: 'Producto',
            folder: 'src/content/product',
            create: true,
            format: 'yaml',
            identifier_field: 'name',
            summary: '{{name}} - {{category}}',
            fields: [
              { label: 'Nombre', name: 'name', widget: 'string' },
              {
                label: 'Categoría',
                name: 'category',
                widget: 'relation',
                collection: 'category',
                search_fields: ['name'],
                value_field: 'name',
                display_fields: ['name'],
              },
              { label: 'Descripción', name: 'description', widget: 'text' },
              { label: 'Imagen', name: 'image', widget: 'image', choose_url: false },
              { label: 'Precio', name: 'price', widget: 'string', required: false },
              { label: 'Destacado', name: 'destacado', widget: 'boolean', default: false, required: false },
            ],
          },
        ],
      },
    });
  </script>
</head>
<body></body>
</html>
