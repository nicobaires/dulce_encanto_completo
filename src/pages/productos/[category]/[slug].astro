---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.svelte';
import Footer from '../../../components/Footer.astro';
import GaleriaProducto from '../../../components/GaleriaProducto.svelte';
import { getCollection } from 'astro:content';
import { siteInfo } from '../../../data/siteInfo';
import { formatPrice, cleanPrice } from '../../../lib/price';
import { buildWaLink } from '../../../lib/whatsapp';

export async function getStaticPaths() {
  const products = await getCollection('product');
  const categories = await getCollection('category');
  return products.map((p) => {
    const cat = categories.find((c) => c.data.slug === p.data.category);
    return {
      params: { category: cat?.id ?? 'otros', slug: p.id },
      props: { product: p, category: cat },
    };
  });
}

const { product, category } = Astro.props;
const { data } = product;
const catName = category?.data.name ?? data.category;
const catSlug = category?.id ?? '';

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.name,
  description: data.description,
  category: catName,
  brand: { '@type': 'Brand', name: siteInfo.brandName },
  image: data.image.src.startsWith('http') ? data.image.src : `${siteInfo.siteUrl}${data.image.src}`,
  ...(cleanPrice(data.price) ? {
    offers: {
      '@type': 'Offer',
      price: cleanPrice(data.price),
      priceCurrency: 'ARS',
    },
  } : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteInfo.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: catName, item: `${siteInfo.siteUrl}/productos/${catSlug}` },
    { '@type': 'ListItem', position: 3, name: data.name },
  ],
};
---

<Layout title={`${data.name} - ${siteInfo.brandName}`} description={`${data.name}: ${data.description}`}>
  <script type="application/ld+json" set:html={JSON.stringify(productLd).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd).replace(/</g, '\\u003c')} />
  <Nav client:idle />

  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
        <a href="/" class="hover:text-rose-400 transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <a href={catSlug ? `/productos/${catSlug}` : '#'} class="hover:text-rose-400 transition-colors">{catName}</a>
        <span class="mx-2">/</span>
        <span class="text-gray-800 dark:text-gray-100 font-medium">{data.name}</span>
      </nav>

      <div class="grid md:grid-cols-2 gap-12 items-start">
        <GaleriaProducto
          client:load
          imagenPrincipal={data.image}
          galeria={data.gallery || []}
          nombre={data.name}
        />

        <div>
          {!data.disponible && (
            <div class="mb-4 inline-flex items-center gap-2 bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-200 text-sm font-semibold px-4 py-1.5 rounded-full border border-amber-300 dark:border-amber-700">
              <i class="fas fa-clock" aria-hidden="true"></i> Temporalmente no disponible
            </div>
          )}

          <h1 class="text-3xl md:text-4xl font-bold text-gray-800 dark:text-gray-100 mb-4">{data.name}</h1>
          <p class="text-lg text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">{data.description}</p>

          {formatPrice(data.price) && (
            <p class="text-3xl font-bold text-rose-500 mb-6">{formatPrice(data.price)}</p>
          )}

          <a
            href={buildWaLink(data.disponible ? 'Hola, me gustaría consultar por ' + data.name : 'Hola, me gustaría consultar cuándo estará disponible ' + data.name)}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex bg-[#25D366] hover:bg-[#1DA851] text-white px-8 py-3 rounded-full font-semibold items-center gap-2 transition-all duration-300 hover:-translate-y-0.5 shadow-md dark:shadow-gray-800 hover:shadow-lg dark:hover:shadow-gray-800"
          >
            <i class="fab fa-whatsapp"></i> {data.disponible ? 'Consultar por WhatsApp' : 'Consultar disponibilidad'}
          </a>

          {catSlug && (
            <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
              <a
                href={`/productos/${catSlug}`}
                class="text-rose-400 hover:text-rose-600 font-medium transition-colors"
              >
                <i class="fas fa-arrow-left mr-2"></i> Ver todos los {catName.toLowerCase()}
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
