---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.svelte';
import Footer from '../components/Footer.astro';
---

<Layout title="Página no encontrada - Cocina LoLa" description="La página que buscas no existe.">
  <Nav client:load />
  <section class="min-h-[60vh] flex items-center justify-center py-24">
    <div class="text-center max-w-lg mx-auto px-4">
      <p class="text-8xl font-bold text-rose-200 mb-4">404</p>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-800 dark:text-gray-100 mb-4">Página no encontrada</h1>
      <p class="text-gray-600 dark:text-gray-300 mb-8">Parece que esta página se fue a hornear... Volvé al inicio para seguir explorando.</p>
      <a href="/" class="inline-flex bg-rose-400 hover:bg-rose-600 text-white px-8 py-3 rounded-full font-semibold transition-all duration-300 hover:-translate-y-0.5 shadow-md dark:shadow-gray-800 hover:shadow-lg dark:hover:shadow-gray-800">
        <i class="fas fa-arrow-left mr-2"></i> Volver al inicio
      </a>
    </div>
  </section>
  <Footer />
</Layout>
