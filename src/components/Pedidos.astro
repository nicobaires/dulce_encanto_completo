<section id="pedidos" class="bg-rose-50 dark:bg-gray-800 py-24 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-16">
      <p class="label text-rose-400 mb-3">CÓMO PEDIR</p>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-800 dark:text-gray-100">Hacé tu pedido en 3 pasos</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <div class="fade-in text-center p-8 rounded-xl bg-rose-50 dark:bg-gray-800 hover:-translate-y-1.5 transition-all duration-300 hover:shadow-md dark:hover:shadow-gray-800">
        <div class="w-14 h-14 bg-rose-400 rounded-full flex items-center justify-center text-white text-2xl font-bold mx-auto mb-5">1</div>
        <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Elegí tus productos</h3>
        <p class="text-sm text-gray-600 dark:text-gray-300">Mirá nuestro catálogo y seleccioná lo que más te guste.</p>
      </div>
      <div class="fade-in text-center p-8 rounded-xl bg-rose-50 dark:bg-gray-800 hover:-translate-y-1.5 transition-all duration-300 hover:shadow-md dark:hover:shadow-gray-800">
        <div class="w-14 h-14 bg-rose-400 rounded-full flex items-center justify-center text-white text-2xl font-bold mx-auto mb-5">2</div>
        <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Contactanos por WhatsApp</h3>
        <p class="text-sm text-gray-600 dark:text-gray-300">Envianos tu pedido y coordinamos los detalles.</p>
      </div>
      <div class="fade-in text-center p-8 rounded-xl bg-rose-50 dark:bg-gray-800 hover:-translate-y-1.5 transition-all duration-300 hover:shadow-md dark:hover:shadow-gray-800">
        <div class="w-14 h-14 bg-rose-400 rounded-full flex items-center justify-center text-white text-2xl font-bold mx-auto mb-5">3</div>
        <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Recibí tu pedido</h3>
        <p class="text-sm text-gray-600 dark:text-gray-300">Lo preparamos con amor y te lo llevamos a casa.</p>
      </div>
    </div>
    <div class="text-center mt-12">
      <a href="https://wa.me/5491123456789" target="_blank" rel="noopener noreferrer" class="inline-flex bg-rose-400 hover:bg-rose-600 text-white px-8 py-3 rounded-full font-semibold items-center gap-2 transition-all duration-300 hover:-translate-y-0.5 shadow-md dark:shadow-gray-800 hover:shadow-lg dark:hover:shadow-gray-800">
        <i class="fab fa-whatsapp" aria-hidden="true"></i> Pedí ahora
      </a>
    </div>
  </div>
</section>
