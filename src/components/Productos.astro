---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
const categories = (await getCollection('category')).slice(0, 5);
---

<section id="productos" class="py-24 bg-white dark:bg-gray-900 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-16">
      <p class="label text-rose-400 mb-3">NUESTROS CLÁSICOS</p>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-800 dark:text-gray-100">Elegí tu favorito</h2>
    </div>

    <div class="flex flex-wrap justify-center gap-6">
      {categories.map((c) => (
        <a
          href={`/productos/${c.id}`}
          class="group w-52 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm dark:shadow-gray-800 hover:shadow-md dark:hover:shadow-gray-800 hover:-translate-y-1.5 transition-all duration-300 overflow-hidden bg-white dark:bg-gray-900"
        >
          <div class="relative h-48 overflow-hidden">
            <Image
              src={c.data.image}
              alt={c.data.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute bottom-3 right-3 w-10 h-10 bg-rose-400 rounded-full flex items-center justify-center text-white text-base shadow-md dark:shadow-gray-800">
              <i class={`fas ${c.data.icon}`} aria-hidden="true"></i>
            </div>
          </div>
          <div class="p-4 text-center">
            <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">{c.data.name}</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 leading-relaxed">{c.data.description}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="flex items-center gap-4 my-16 max-w-xl mx-auto">
      <div class="flex-1 h-px bg-gray-200 dark:bg-gray-700"></div>
      <i class="fas fa-cake-candles text-rose-300 text-xl" aria-hidden="true"></i>
      <div class="flex-1 h-px bg-gray-200 dark:bg-gray-700"></div>
    </div>

    <div class="text-center">
      <a
        href="/productos"
        class="inline-flex items-center gap-3 bg-rose-400 hover:bg-rose-600 text-white font-semibold px-10 py-4 rounded-full transition-all duration-300 hover:-translate-y-0.5 shadow-md dark:shadow-gray-800 hover:shadow-lg dark:hover:shadow-gray-800 text-lg"
      >
        Ver catálogo completo
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>
