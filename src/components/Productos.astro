---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
const categories = await getCollection('category');
---

<section id="productos" class="py-24 bg-white scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-16">
      <p class="label text-rose-400 mb-3">NUESTROS CLÁSICOS</p>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-800">Elegí tu favorito</h2>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-6">
      {categories.map((c) => (
        <a href={`/productos/${c.id}`} class="product-card fade-in text-center hover:-translate-y-2.5 transition-all duration-300 cursor-pointer block">
          <div class="relative rounded-xl overflow-hidden mb-5 shadow-md h-56">
            <Image src={c.data.image} alt={c.data.name} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
            <div class="absolute bottom-4 right-4 w-12 h-12 bg-rose-400 rounded-full flex items-center justify-center text-white text-lg shadow-md">
              <i class={`fas ${c.data.icon}`} aria-hidden="true"></i>
            </div>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-2">{c.data.name}</h3>
          <p class="text-sm text-gray-600">{c.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
