---
import { Image } from 'astro:assets';
export interface Props {
  image: ImageMetadata;
  name: string;
  description: string;
  price?: string;
  href?: string;
}
const { image, name, description, price, href } = Astro.props;

function formatPrice(value: string | undefined): string {
  if (!value) return '';
  const num = parseInt(value.replace(/[^0-9]/g, ''), 10);
  if (isNaN(num)) return '';
  return '$' + num.toLocaleString('es-AR');
}

const Tag = href ? 'a' : 'div';
const extraProps = href ? { href } : {};
---

<Tag {...extraProps} class="product-card fade-in bg-white dark:bg-gray-900 rounded-2xl overflow-hidden shadow-lg dark:shadow-gray-800 hover:-translate-y-1.5 transition-all duration-300 hover:shadow-xl dark:hover:shadow-gray-800 cursor-pointer block border border-gray-100 dark:border-gray-700">
  <div class="relative h-56 overflow-hidden">
    <Image
      src={image}
      alt={name}
      class="w-full h-full object-cover hover:scale-105 transition-transform duration-300 will-change-transform"
      widths={[300, 400, 600, 800]}
      sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw"
      loading="lazy"
    />
  </div>
  <div class="p-6">
    <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100 mb-2">{name}</h3>
    <p class="text-sm text-gray-600 dark:text-gray-300 mb-3">{description}</p>
    {formatPrice(price) && <p class="text-rose-500 font-bold text-lg">{formatPrice(price)}</p>}
  </div>
</Tag>
