---
const year = new Date().getFullYear();
---

<footer id="contacto" role="contentinfo" class="bg-[#3b302d] text-white py-16">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10 mb-8">
      <div>
        <h4 class="text-lg font-bold mb-3">Cocina LoLa</h4>
        <p class="text-gray-400 text-sm">Pastelería Artesanal</p>
      </div>
      <div>
        <h5 class="font-semibold mb-4 text-gray-200">Navegación</h5>
        <ul class="space-y-2 text-sm">
          <li><a href="/#inicio" class="text-gray-400 hover:text-rose-400 transition-colors">Inicio</a></li>
          <li><a href="/#productos" class="text-gray-400 hover:text-rose-400 transition-colors">Productos</a></li>
          <li><a href="/#sobre-mi" class="text-gray-400 hover:text-rose-400 transition-colors">Sobre mí</a></li>
          <li><a href="/#pedidos" class="text-gray-400 hover:text-rose-400 transition-colors">Pedidos</a></li>
        </ul>
      </div>
      <div>
        <h5 class="font-semibold mb-4 text-gray-200">Contacto</h5>
        <p class="text-gray-400 text-sm mb-2"><i class="fab fa-whatsapp mr-2" aria-hidden="true"></i>+54 9 11 2345 6789</p>
        <p class="text-gray-400 text-sm mb-2"><i class="fas fa-envelope mr-2" aria-hidden="true"></i>info@dulceencanto.com</p>
        <p class="text-gray-400 text-sm"><i class="fas fa-map-marker-alt mr-2" aria-hidden="true"></i>Buenos Aires, Argentina</p>
      </div>
      <div>
        <h5 class="font-semibold mb-4 text-gray-200">Sígueme</h5>
        <div class="flex gap-3">
          <a href="#" aria-label="Instagram" class="w-10 h-10 bg-rose-400 hover:bg-rose-600 rounded-full flex items-center justify-center text-white transition-all duration-300 hover:-translate-y-0.5">
            <i class="fab fa-instagram" aria-hidden="true"></i>
          </a>
          <a href="#" aria-label="Facebook" class="w-10 h-10 bg-rose-400 hover:bg-rose-600 rounded-full flex items-center justify-center text-white transition-all duration-300 hover:-translate-y-0.5">
            <i class="fab fa-facebook" aria-hidden="true"></i>
          </a>
          <a href="#" aria-label="Pinterest" class="w-10 h-10 bg-rose-400 hover:bg-rose-600 rounded-full flex items-center justify-center text-white transition-all duration-300 hover:-translate-y-0.5">
            <i class="fab fa-pinterest" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
    <div class="border-t border-gray-700 pt-8 text-center text-sm text-gray-400">
      <p>&copy; {year} Cocina LoLa. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
