        <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Pedidos seguros</h3>
        <p class="text-sm text-gray-600 dark:text-gray-300">Tu pedido estará siempre protegido.</p>
      </div>
    </div>
  </div>
</section>
