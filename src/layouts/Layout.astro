---
import '../styles/globals.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/800.css';
import poppins400Url from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import playfair700Url from '@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url';
import { siteInfo } from '../data/siteInfo';
import { buildWaLink } from '../lib/whatsapp';
// TEMPORALMENTE DESACTIVADO: sospecha de que reejecuta scripts del body
// (incluido el init de Netlify Identity) causando doble iframe del widget.
// Si el bug de la invitación se soluciona sin esto, dejarlo así o reintroducir
// con más cuidado (ej. excluyendo la home, o usando transition:persist).
// import { ViewTransitions } from 'astro:transitions';
export interface Props {
  title: string;
  description: string;
  businessSchema?: boolean;
}

const { title, description, businessSchema } = Astro.props;

const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: siteInfo.brandName,
  description: siteInfo.siteDescription,
  url: siteInfo.siteUrl,
  telephone: siteInfo.contact.WhatsApp,
  image: `${siteInfo.siteUrl}/img/img_hero.webp`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lanús, Buenos Aires',
    addressCountry: 'AR',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: siteInfo.contact.WhatsApp,
    contactType: 'customer service',
    availableLanguage: ['Spanish'],
  },
  areaServed: 'Buenos Aires, Argentina',
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content={siteInfo.brandName}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={Astro.url.href}>
  <meta property="og:image" content={`${siteInfo.siteUrl}/img/img_hero.webp`}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={`${siteInfo.siteUrl}/img/img_hero.webp`}>
  <link rel="canonical" href={Astro.url.href}>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  <link rel="preload" href={poppins400Url} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={playfair700Url} as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧁</text></svg>">
  <!-- <ViewTransitions /> -->
  {businessSchema && <script type="application/ld+json" set:html={JSON.stringify(businessLd).replace(/</g, '\\u003c')} />}
  <script is:inline>
    (function() {
      function applyDark(doc) {
        var saved = localStorage.getItem('dark-mode');
        var shouldBeDark = saved === 'true' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
        doc.documentElement.classList.toggle('dark', shouldBeDark);
      }
      applyDark(document);
    })();
  </script>
</head>
<body class="bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-200">
  <slot />
  <script is:inline src="/scripts/main.js" defer></script>

  <a href={buildWaLink()} target="_blank" rel="noopener noreferrer" aria-label="Hacer pedido por WhatsApp" class="group fixed bottom-6 right-6 z-50 bg-[#25D366] hover:bg-[#1DA851] text-white w-14 h-14 rounded-full flex items-center justify-center text-3xl transition-all duration-300 hover:-translate-y-1 shadow-lg dark:shadow-gray-800 hover:shadow-xl animate-bounce hover:animate-none">
    <i class="fab fa-whatsapp" aria-hidden="true"></i>
  </a>
<script is:inline>
  (function() {
    var path = window.location.pathname;
    var hash = window.location.hash;
    var isAdmin = path.indexOf('/admin') === 0;
    var hasToken = hash.indexOf('invite_token') !== -1 || hash.indexOf('recovery_token') !== -1 || hash.indexOf('confirmation_token') !== -1;
    if (!isAdmin && !hasToken) return;

    var s = document.createElement('script');
    s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
    s.onload = function() {
      window.addEventListener("load", function() {
        if (!window.netlifyIdentity || window.__netlifyIdentityInitialized) return;
        window.__netlifyIdentityInitialized = true;
        window.netlifyIdentity.init();
        window.netlifyIdentity.on("login", function() { document.location.href = "/admin/"; });
      });
    };
    document.body.appendChild(s);
  })();
</script>
</body>
</html>